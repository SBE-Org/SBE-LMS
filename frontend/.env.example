# ---------------------------------------------------------------------------
# Shaggar BPO Academy — frontend settings
# Copy this file to ".env" for local development. On Vercel, add the same
# names under Project → Settings → Environment Variables, then redeploy
# (Vite reads them at build time).
# ---------------------------------------------------------------------------

# Address of the backend API, without a trailing slash and without /api.
#   Local:       http://localhost:5000
#   Production:  https://shaggar-lms-api.onrender.com   (your API host)
VITE_API_URL=http://localhost:5000

# Name shown before the API answers (the API's APP_NAME is used after that)
VITE_APP_NAME=Shaggar BPO Academy
