# ---------------------------------------------------------------------------
# Shaggar BPO Academy — backend (API) settings
# Copy this file to ".env" for local development. On your host (Render,
# Railway, a VPS…) set the same names as environment variables instead.
# ---------------------------------------------------------------------------

# Port the API listens on. Most hosts set PORT for you — leave it as is there.
PORT=5000

# development | production
NODE_ENV=development

# MongoDB connection string.
#   Local:          mongodb://127.0.0.1:27017/shaggar_lms
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shaggar_lms?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shaggar_lms

# Secret used to sign login tokens. REQUIRED in production.
# Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a sign-in lasts before the person must sign in again (e.g. 12h, 7d).
JWT_EXPIRES_IN=7d

# Frontend address(es) allowed to call this API (CORS). Comma-separated, no
# trailing slash. Add your Vercel URL(s) and any custom domain.
#   e.g. CLIENT_URL=https://shaggar-lms.vercel.app,https://academy.shaggar.com
CLIENT_URL=http://localhost:5173

# Set to 1 when the API runs behind a proxy / load balancer (Render, Railway,
# Heroku, Nginx). Needed so login rate limiting sees the real client IP.
TRUST_PROXY=0

# Branding shown on pages and certificates
APP_NAME=Shaggar BPO Academy
APP_COMPANY=Shaggar BPO Enterprise

# Time zone used for "today" (due dates, overdue checks)
APP_TIMEZONE=Africa/Addis_Ababa

# Largest lesson file upload allowed, in MB (files are stored in MongoDB GridFS)
MAX_UPLOAD_MB=200

# Failed sign-ins allowed per email + IP within 15 minutes
LOGIN_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Connection with the Shaggar BPO Talent Pool (optional)
# ---------------------------------------------------------------------------
# The same long random key, set here AND on the Talent Pool server. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_KEY=
# The Talent Pool API address (its Render URL), so finished training is reported back. No trailing slash.
TALENT_POOL_URL=
# Optional: code of the department new learners from the Talent Pool are put in (e.g. TP). Empty = none.
TALENT_POOL_DEPARTMENT=
